    "# Case 23: all clouds\n",
    "# Case 51: mix of floes, cloud, slush\n",
    "idx = 11\n",
    "\n",
    "\n",
    "include(\"../scripts/dev/segmentation.jl\")\n",
    "\n",
    "\n",
    "masks = Dict(idx => Dict(\n",
    "        k => classified_imgs[idx] .== classifier.key[k] for k in keys(classifier.key)\n",
    "        ) for idx in 1:length(classified_imgs))\n",
    "\n",
    "params = [\n",
    "    (max_hole_fill=500, max_depth=5, max_depth_ratio=0.5, max_expand=3, opening_strel=strel_diamond((3,3))),\n",
    "    (max_hole_fill=500, max_depth=5, max_depth_ratio=0.5, max_expand=3, opening_strel=strel_box((3,3))),\n",
    "    (max_hole_fill=500, max_depth=5, max_depth_ratio=0.5, max_expand=3, opening_strel=strel_disk(4)) # round-ish\n",
    "]\n",
    "\n",
    "splits = [\n",
    "    IceFloeTracker.FSPipeline.dist_morph_split(binarized_imgs[idx]; pset...) for pset in params\n",
    "    ]\n",
    "\n",
    "# can add the ice classification result too, if wanted\n",
    "\n",
    "remove_small_segments!.(splits, 64)\n",
    "\n",
    "cviews = view_seg_random.(SegmentedImage.([tc_imgs[idx]], splits))\n",
    "overlays = copy(cviews)\n",
    "outlines = (binary_floes[idx] .> 0) .&& .! (erode(binary_floes[idx]) .> 0)\n",
    "for c in overlays\n",
    "    c[outlines .> 0] .= RGB(1)\n",
    "end\n",
    "\n",
    "mosaicview(preproc_gray[idx], fc_imgs[idx], colorize_classification(classified_imgs[idx]),\n",
    "    overlays...,\n",
    "    nrow=2, rowmajor=true, npad=10, fillvalue=RGBA(0,0,0,0)\n",
    ")"
   ]
  },
