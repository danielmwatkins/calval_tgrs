   "id": "98364c94-1f7c-4a47-8461-0ff17c8d233d",
   "metadata": {},
   "outputs": [],
   "source": [
    "preproc_function = FSPipeline.Preprocess(\n",
    "    diffusion_algorithm = PeronaMalikDiffusion(; λ=0.1, K=0.1, niters=5, g=\"exponential\"),\n",
    "    adapthisteq_params = (nbins=256, rblocks=2, cblocks=2, clip=5),\n",
    "    unsharp_mask_params = (radius=50, amount=0.3, threshold=0.01),\n",
    ")\n",
    "tiles = get_tiles(tc_imgs[1], (400, 400)) # single tile\n",
    "preproc_gray = preproc_function.(tc_imgs, land_masks, [tiles]);"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "af57122e-3e6c-45ca-a4df-2b503525b735",
