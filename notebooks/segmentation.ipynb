   "id": "ac88c8cf-d415-4227-8663-26ad1233d565",
   "metadata": {},
   "outputs": [],
   "source": [
    "split_labeled = dist_morph_split.(adaptive_bin;   \n",
    "    max_depth=25, max_depth_ratio=0.5, max_expand=2, opening_strel=strel_disk(3));\n",
    "\n",
    "# If these aren't removed, the rotation / shape difference stuff fails\n",
    "remove_small_segments!.(split_labeled, 100);\n",
    "remove_small_segments!.(manual_labeled, 100);"
   ]
  },
  {
   "cell_type": "code",
