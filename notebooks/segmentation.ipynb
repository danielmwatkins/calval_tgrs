   "id": "e635bea1-1a33-4281-88c7-e39c6355691e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Workflows produce binary images\n",
    "function kmeans_workflow(preproc_gray, fc_masked, water_mask, ice_mask, cloud_mask; k=4, cluster_selection_algorithm=cluster_algo)\n",
    "    masked_gray = apply_landmask(preproc_gray, water_mask)\n",
    "    kmeans_result = kmeans_binarization(\n",
    "        masked_gray, fc_masked; k=k, cluster_selection_algorithm=cluster_algo) .> 0\n",
    "    return kmeans_result\n",
    "end\n",
    "\n",
    "function adaptive_workflow(preproc_gray, land_mask, water_mask, ice_mask, cloud_mask; window_size=400, percentage=0)\n",
    "    adaptive_result = binarize(preproc_gray, AdaptiveThreshold(; window_size=window_size, percentage=percentage)) .> 0\n",
    "    apply_landmask!(adaptive_result, land_mask)\n",
    "    apply_landmask!(adaptive_result, water_mask)\n",
    "    return adaptive_result\n",
    "end"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b4c00f4f-1b85-47f5-9256-5ced366d0f84",
   "metadata": {},
   "outputs": [],
   "source": [
    "adaptive_bin = adaptive_workflow.(\n",
    "    preproc_gray, land_masks, water_masks, ice_masks, cloud_masks; window_size=400);"
   ]
  },
