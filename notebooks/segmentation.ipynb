    "\n",
    "contrast_imgs = [assign_values(labeled_imgs[i], Dict(\n",
    "                l => p for (l, p) in zip(dfs[i].label, dfs[i].b1_mean_boundary_contrast))) for i in 1:length(dfs)];\n",
    "\n",
    "cloud_frac_imgs = [assign_values(labeled_imgs[i], Dict(\n",
