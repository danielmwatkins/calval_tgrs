   "id": "9e1725e8-bbfc-487e-9488-4c89e66b1ccd",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Included in the filter-floes function\n",
    "function get_relevant_set(labels1, labels2)\n",
    "    df1 = regionprops_table(labels1; properties=[:label, :area, :bbox, :centroid])\n",
    "    df2 = regionprops_table(labels2; properties=[:label, :area, :bbox, :centroid])\n",
    "    return get_relevant_set(df1, df2, labels1, labels2)\n",
    "end\n",
    "\n",
    "# This produces a set of dictionaries mapping labels from manual to automatic segments\n",
    "df_list = get_relevant_set.(manual_labeled, split_labeled);"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "58f243c8-3259-449e-bf31-0699ef532e9d",
   "metadata": {},
   "source": [
